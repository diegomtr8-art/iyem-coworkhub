# URL de la API de Nódico que usa la app.
# - Servidor de pruebas (lo normal): https://prueba.nodico.com.mx/api/v1
# - Laravel en tu computadora, con Expo Go en la misma wifi:
#   http://TU-IP-LOCAL:8010/api/v1  (php artisan serve --host=0.0.0.0 --port=8010)
# Los builds de EAS no usan este archivo: toman la URL de su perfil en eas.json.
EXPO_PUBLIC_API_URL=https://prueba.nodico.com.mx/api/v1
