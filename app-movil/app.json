{
  "expo": {
    "name": "Nódico",
    "slug": "nodico",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nodico",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1A1918",
    "ios": {
      "bundleIdentifier": "mx.com.nodico.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Nódico usa Face ID para proteger tu cuenta cuando vuelves a abrir la app.",
        "NSCameraUsageDescription": "Nódico usa la cámara para tomar tu foto de perfil.",
        "NSPhotoLibraryUsageDescription": "Nódico usa tus fotos para elegir tu foto de perfil.",
        "NSCalendarsUsageDescription": "Nódico añade tus reservas a tu calendario.",
        "NSCalendarsWriteOnlyAccessUsageDescription": "Nódico añade tus reservas a tu calendario."
      }
    },
    "android": {
      "package": "mx.com.nodico.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFE124",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1918",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Nódico usa Face ID para proteger tu cuenta cuando vuelves a abrir la app."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nódico usa tus fotos para elegir tu foto de perfil.",
          "cameraPermission": "Nódico usa la cámara para tomar tu foto de perfil."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Nódico añade tus reservas a tu calendario."
        }
      ],
      "expo-sharing",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.mx.com.nodico",
          "enableGooglePay": false
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b99d9db4-70ce-45b2-a978-6222bdebeead"
      }
    },
    "owner": "diegomtr8"
  }
}
