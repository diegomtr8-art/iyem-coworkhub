# Agente de acceso de Nódico — configuración
#
# Copia este archivo a «.env» EN LA COMPUTADORA DE LA OFICINA y rellena los
# valores reales. El .env real NUNCA se versiona ni sale de esa máquina: lleva
# credenciales de la base de Smart Pass y el secreto compartido con Laravel.

# --- Base de datos de Smart Pass (solo lectura) ---
SMARTPASS_DB_HOST=127.0.0.1
SMARTPASS_DB_PORT=3307
SMARTPASS_DB_NAME=tdx_face_owl
SMARTPASS_DB_USER=nodico_agente        # crear un usuario de SOLO LECTURA, no root
SMARTPASS_DB_PASS=

# Zona horaria en la que Smart Pass guarda create_time (naive). Mérida = UTC-6.
SMARTPASS_TZ=America/Merida

# --- API web de Smart Pass (para abrir puerta y enrolar rostros: Fases 3 y 4) ---
# Solo la usa la herramienta smartpass.php; el daemon no la necesita para leer.
SMARTPASS_URL=http://127.0.0.1:9000
SMARTPASS_USER=                        # usuario del panel de Smart Pass
SMARTPASS_PASS=                        # su contraseña (NUNCA al repo; vive solo aquí)
# Clave/IV 3DES incrustados en la SPA de Smart Pass; estos son los de esta
# instalación. Solo cámbialos si actualizas el firmware y dejan de funcionar.
SMARTPASS_3DES_KEY=WfJTKO9S4eLkrPz2JKrAnzdb
SMARTPASS_3DES_IV=D076D35C

# --- Nódico (Laravel en Hostinger) ---
NODICO_URL=https://prueba.nodico.com.mx
# Secreto compartido para firmar cada envío (HMAC-SHA256). Genéralo largo y
# aleatorio, y ponlo IGUAL en el .env de Laravel (ACCESO_AGENTE_SECRETO).
NODICO_SECRETO=

# --- Comportamiento ---
SONDEO_SEGUNDOS=5          # cada cuánto se consulta Smart Pass por eventos nuevos
LOTE_MAXIMO=200            # eventos por envío
SALUD_PUERTO=9099          # endpoint local de salud (http://127.0.0.1:9099/salud)
HTTP_TIMEOUT=15            # segundos de espera a Laravel

# Directorio de estado (cursor, cola, logs). Por defecto, junto al agente.
# ESTADO_DIR=C:\SMART_PASS\nodico-agente\estado

# --- Torno FR07: estado y reconexión automática (Fases 1-4) ---
TORNO_DEVICE_ID=1          # id del FR07 en la BD de Smart Pass (tdx_device_base_info)
TORNO_TIMEOUT_SEG=120      # sin latido más de esto → el panel lo marca «sin conexión»

# Motor de reconexión automática. APAGADO por defecto: enciéndelo cuando esté
# validado. LEE seguido (barato), ESCRIBE poco (el «Grabar» desgasta flash).
RECONEXION_AUTO=0                 # 1 = reconecta solo; 0 = solo detecta y cuenta
RECONEXION_CONFIRMAR_SEG=60       # sin latido este tiempo → caída CONFIRMADA (no un blip)
RECONEXION_SILENCIO_SEG=30        # si hubo un paso hace menos, pospone (no cortar una apertura)
RECONEXION_TOPE_HORA=6            # máx. reconexiones por hora; al tope, se detiene y AVISA
RECONEXION_ESCALONES=60,300,900,1800   # espera creciente entre intentos (segundos)
OPERACION_HORA_INICIO=9           # horario de operación (lun-vie): a esta hora empieza
OPERACION_HORA_FIN=19             # y a esta termina; fuera de él se deja descansar al torno
