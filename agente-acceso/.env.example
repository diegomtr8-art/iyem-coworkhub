# Agente de acceso de Nódico — configuración
#
# Copia este archivo a «.env» EN LA COMPUTADORA DE LA OFICINA y rellena los
# valores reales. El .env real NUNCA se versiona ni sale de esa máquina: lleva
# credenciales de la base de Smart Pass y el secreto compartido con Laravel.

# --- Base de datos de Smart Pass (solo lectura) ---
SMARTPASS_DB_HOST=127.0.0.1
SMARTPASS_DB_PORT=3307
SMARTPASS_DB_NAME=tdx_face_owl
SMARTPASS_DB_USER=nodico_agente        # crear un usuario de SOLO LECTURA, no root
SMARTPASS_DB_PASS=

# Zona horaria en la que Smart Pass guarda create_time (naive). Mérida = UTC-6.
SMARTPASS_TZ=America/Merida

# --- Nódico (Laravel en Hostinger) ---
NODICO_URL=https://prueba.nodico.com.mx
# Secreto compartido para firmar cada envío (HMAC-SHA256). Genéralo largo y
# aleatorio, y ponlo IGUAL en el .env de Laravel (ACCESO_AGENTE_SECRETO).
NODICO_SECRETO=

# --- Comportamiento ---
SONDEO_SEGUNDOS=5          # cada cuánto se consulta Smart Pass por eventos nuevos
LOTE_MAXIMO=200            # eventos por envío
SALUD_PUERTO=9099          # endpoint local de salud (http://127.0.0.1:9099/salud)
HTTP_TIMEOUT=15            # segundos de espera a Laravel

# Directorio de estado (cursor, cola, logs). Por defecto, junto al agente.
# ESTADO_DIR=C:\SMART_PASS\nodico-agente\estado
