APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Correo saliente --------------------------------------------------------
# Sin esto NO hay verificacion de cuenta ni recuperacion de contrasena: el
# registro queda inservible. Con MAIL_MAILER=log los correos solo se escriben
# en storage/logs/laravel.log y nunca salen.
#
# Nodico (buzon de Hostinger, el que se usa):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.hostinger.com
#   MAIL_PORT=465
#   MAIL_SCHEME=smtps
#   MAIL_USERNAME=contacto@nodico.com.mx
#   MAIL_PASSWORD="<contrasena del buzon, entre comillas si lleva = o #>"
#   MAIL_FROM_ADDRESS="contacto@nodico.com.mx"
#
# Gmail (alternativa provisional):
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_SCHEME=null          <- 587 negocia STARTTLS solo; para 465 va "smtps"
#   MAIL_USERNAME=lacuenta@gmail.com
#   MAIL_PASSWORD=<contrasena de aplicacion de 16 caracteres, sin espacios>
#   MAIL_FROM_ADDRESS="lacuenta@gmail.com"   <- la MISMA que autentica
#
# Gmail exige una "contrasena de aplicacion" (myaccount.google.com/apppasswords),
# no la contrasena de la cuenta, y la cuenta necesita verificacion en dos pasos.
# Limite: ~500 correos al dia. Para produccion conviene un dominio propio
# (noreply@nodico.com.mx) con SPF y DKIM: Gmail personal cae en spam.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# A donde llegan los mensajes del formulario de contacto del sitio publico.
NODICO_CONTACTO_EMAIL=contacto@nodico.com.mx

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Seguridad
# Con false la CSP solo informa; ponerlo en true la aplica de verdad.
NODICO_CSP_ESTRICTA=false

# Acceso con Google. Mientras el interruptor este en false, el boton no se
# dibuja y la ruta responde 404. La URI de retorno tiene que estar dada de alta
# en Google Cloud Console, identica hasta el ultimo caracter.
NODICO_GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Enlace magico: entrar sin contrasena con un enlace de un solo uso.
NODICO_ENLACE_MAGICO_ENABLED=true

# --- Operacion del espacio (Fase 1 de portales) -----------------------------
# Horario en el que se puede reservar. Ninguna reserva cae fuera ni cruza el
# cierre. Si cambia, cambia tambien NODICO_HORARIOS, que es el texto que ve el
# publico: son dos cosas distintas y se descuadran con facilidad.
NODICO_APERTURA=09:00
NODICO_CIERRE=19:00

# --- Facturacion ------------------------------------------------------------
# Nodico NO timbra: recopila los datos fiscales y se los pasa a contabilidad
# del IYEM. Este es el correo que se le ensena al miembro para reclamar una
# factura que no llega.
NODICO_EMAIL_FACTURACION=facturacion@nodico.com.mx

# --- Salones para eventos ---------------------------------------------------
# Punto de partida del cotizador. Lo que se cobro queda congelado en cada fila
# de `rentas_salon`, asi que cambiar esto no reescribe cotizaciones viejas.
NODICO_SALON_PRECIO_HORA=600

# ── Stripe (Fase 4.A — cobro dentro de Nódico) ───────────────────────────────
# Claves de PRUEBA en desarrollo/staging; las de producción solo en el .env del
# servidor de producción. La publishable (STRIPE_KEY) es la única que llega al
# navegador; la secret y el webhook secret nunca salen del servidor.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=mxn
CASHIER_CURRENCY_LOCALE=es_MX

# ── Pasarela de tarjeta (migracion de Stripe) ───────────────────────────────
# Que pasarela cobra con tarjeta: stripe | openpay | bbva. Una sola a la vez;
# volver a Stripe es cambiar esta linea (y `php artisan config:cache`). Lo ya
# cobrado sigue su curso: el webhook de Stripe sigue escuchando y los cargos
# pendientes de Openpay/BBVA los confirma `nodico:confirmar-cargos` (5 min).
# Ver docs/PAGOS-OPENPAY.md y docs/PAGOS-BBVA.md.
PAGOS_PASARELA=stripe
#
# OJO CON EL IMPORTE: Openpay y BBVA cobran en PESOS con dos decimales, no en
# centavos. "amount": 100 son cien pesos. Stripe usaba centavos enteros.
#
# Autenticacion (las dos): HTTP Basic con la llave PRIVADA como usuario y la
# contrasena vacia. La privada NUNCA sale del servidor; la publica es la unica
# que llega al navegador (solo sirve para crear tokens con openpay.js).
# Los valores de abajo van vacios o inventados: los reales, solo en el .env.

# ── Openpay (https://documents.openpay.mx/docs/api/) ────────────────────────
# Sandbox https://sandbox-api.openpay.mx  ·  Produccion https://api.openpay.mx
# La tarjeta se teclea en Nodico (openpay.js + antifraude), como exige Openpay
# para produccion. Sin merchant ni llave privada, la tarjeta se ve en vista
# previa; sin llave publica, se usa el formulario de Openpay.
OPENPAY_MERCHANT_ID=
OPENPAY_LLAVE_PRIVADA=
OPENPAY_LLAVE_PUBLICA=
OPENPAY_SANDBOX=true
# si_hace_falta: sin 3-D Secure salvo que el antifraude rechace por riesgo
# (3005), y entonces se reintenta con 3-D Secure. siempre: todos con 3-D Secure.
OPENPAY_3DS=si_hace_falta
# Webhook (POST /openpay/webhook): Openpay no firma sus avisos, solo manda HTTP
# Basic con estos datos, que se registran junto con el webhook en Openpay.
# Largos y aleatorios. Sin los dos, el endpoint rechaza todo.
OPENPAY_WEBHOOK_USUARIO=
OPENPAY_WEBHOOK_CONTRASENA=

# ── Ecommerce BBVA (https://docs.ecommercebbva.com/) ────────────────────────
# La misma plataforma que Openpay con marca propia y API recortada (solo
# cargos). Sandbox https://sand-api.ecommercebbva.com · Produccion
# https://api.ecommercebbva.com. La afiliacion (`affiliation_bbva`) es
# obligatoria en cada cargo; la da el ejecutivo.
# BBVA_CAPTURA: token = tarjeta tecleada en Nodico (openpay.js; "cargo sin
# VPOS", requiere autorizacion del ejecutivo) · vpos = formulario del banco.
BBVA_MERCHANT_ID=
BBVA_LLAVE_PRIVADA=
BBVA_LLAVE_PUBLICA=
BBVA_AFILIACION=
BBVA_SANDBOX=true
BBVA_CAPTURA=vpos

# --- Control de acceso (Fase 2 — Smart Pass) --------------------------------
# Secreto compartido con el agente local de acceso (en el agente es
# NODICO_SECRETO). Firma HMAC-SHA256 cada envio del agente y aqui se verifica.
# Vacio = se rechaza todo: sin secreto no se procesa nada sin firmar.
ACCESO_AGENTE_SECRETO=
# Ventana de antirrebote de reconocimientos repetidos (segundos).
ACCESO_ANTIRREBOTE_SEGUNDOS=90
# Ventana anti-replay de la firma del agente (segundos).
ACCESO_REPLAY_VENTANA_SEGUNDOS=300
